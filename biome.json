{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.claude",
      "!!.agents",
      "!!.audit",
      "!!node_modules",
      "!!dist",
      "!!dist-mock",
      "!!.e2e",
      "!!playwright-report",
      "!!perf-results",
      "!!test-results",
      "!!target",
      "!!src-tauri/gen",
      "!!fixtures/generated",
      "!!src/ipc/bindings.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["e2e/**/*.e2e.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@e2e-dev/web": "Import test from the guarded e2e fixtures.",
                  "e2e": {
                    "importNames": ["test"],
                    "message": "Import test from the guarded e2e fixtures."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["tests/playwright/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": "Import test and expect from the guarded Playwright fixtures."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/ipc/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "./ipc/bindings": "Import from src/ipc so mock builds can swap the commands.",
                  "./ipc/bindings.ts": "Import from src/ipc so mock builds can swap the commands.",
                  "../ipc/bindings": "Import from src/ipc so mock builds can swap the commands.",
                  "../ipc/bindings.ts": "Import from src/ipc so mock builds can swap the commands.",
                  "../../ipc/bindings": "Import from src/ipc so mock builds can swap the commands.",
                  "../../ipc/bindings.ts": "Import from src/ipc so mock builds can swap the commands."
                }
              }
            }
          }
        }
      }
    }
  ]
}
