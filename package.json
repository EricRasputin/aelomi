{
  "name": "aelomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/tauri-dev.ts",
    "build": "pnpm typecheck && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "vitest run",
    "check:all": "node scripts/check-all.ts",
    "bindings": "AELOMI_WRITE_BINDINGS=1 cargo test -p aelomi --lib bindings_are_current",
    "check-licenses": "node scripts/check-licenses.mjs",
    "build:mock": "pnpm typecheck && vite build --mode mock",
    "preview:mock": "vite preview --mode mock --host 127.0.0.1",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 e2e run",
    "test:playwright": "playwright test --project webkit",
    "check:no-mock": "node scripts/check-no-mock.mjs",
    "perf:cold": "node perf/cold-start.ts",
    "fixtures": "node fixtures/generate.ts",
    "perf:keystroke": "playwright test --project perf --workers 1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-router": "1.170.41",
    "@tauri-apps/api": "2.12.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yjs": "13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@e2e-dev/web": "0.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "e2e": "0.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
