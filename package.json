{
  "name": "aelomi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "vitest run",
    "bindings": "AELOMI_WRITE_BINDINGS=1 cargo test -p aelomi --lib bindings_are_current",
    "check-licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-router": "1.170.41",
    "@tauri-apps/api": "2.12.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
