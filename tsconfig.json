{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@ipc-commands": ["./src/ipc/bindings.ts"] }
  },
  "include": [
    "src",
    "e2e",
    "tests",
    "e2e.config.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    ".claude",
    ".agents",
    "node_modules",
    "dist",
    "dist-mock",
    "target"
  ]
}
